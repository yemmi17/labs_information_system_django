# Скопируйте в файл .env и подставьте токен от @BotFather
BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Если до api.telegram.org нет прямого доступа — локальный SOCKS5 (часто порт VPN-клиента):
# TELEGRAM_PROXY=socks5://127.0.0.1:1080

# Таймаут HTTP к API (секунды), по умолчанию 60:
# TELEGRAM_HTTP_TIMEOUT=90
